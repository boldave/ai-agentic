#!/usr/bin/env bash
# Jedna klatka animacji, wybrana na podstawie bieżącej sekundy.
#
# tmux nie ma w formatach źródła czasu, więc klatkę musi podać proces.
# status-interval przyjmuje tylko pełne sekundy - stąd 1 klatka/s.
klatki=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
printf '%s' "${klatki[$(( $(date +%s) % ${#klatki[@]} ))]}"
