#!/usr/bin/env bash
# One frame of the animation, picked from the current second.
#
# tmux has no source of time in its formats, so a process has to supply the
# frame. status-interval accepts whole seconds only - hence 1 frame/s.
frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
printf '%s' "${frames[$(( $(date +%s) % ${#frames[@]} ))]}"
